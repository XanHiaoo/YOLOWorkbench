{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "YOLO C++ (Docker gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/workspace/cpp/build/yolo_cpp",
      "args": [],
      "stopAtEntry": false,
      "cwd": "/workspace/cpp",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "/opt/onnxruntime/lib:/usr/local/lib/python3.12/dist-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/dist-packages/nvidia/cudnn/lib:/usr/local/lib/python3.12/dist-packages/nvidia/cufft/lib:/usr/local/lib/python3.12/dist-packages/nvidia/curand/lib:/usr/local/cuda/lib64"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "sourceFileMap": {
        "/workspace": "${workspaceFolder}"
      },
      "preLaunchTask": "CMake: Build (in container)",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": [
          "exec",
          "-i",
          "yoloworkbench",
          "sh",
          "-c"
        ],
        "debuggerPath": "/usr/bin/gdb"
      },
      "setupCommands": [
        {
          "description": "Enable pretty printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set disassembly flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
