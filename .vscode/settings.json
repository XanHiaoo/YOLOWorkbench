{
    // 本项目的 C++ 编译在 Docker 容器内完成，
    // Windows 宿主机上没有 C++ 编译器和标准库头文件，
    // 因此关闭 VS Code 的 include 错误提示（波浪线），避免误报。
    // 工作流：本机编辑 + 容器编译（docker run / docker exec）。
    "C_Cpp.errorSquiggles": "Disabled",
    "C_Cpp.intelliSenseEngineFallback": "Disabled",
    "cmake.sourceDirectory": "${workspaceFolder}/cpp"
}
